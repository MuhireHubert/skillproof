PORT=8787
# Supabase: Project Settings > Database > Connection string (use the pooled "transaction" string in production)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Verify user tokens with the JWT secret (Project Settings > API), or set SUPABASE_JWKS_URL instead
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGIN=http://localhost:5173

# AI drafting of standards and course mapping (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# USSD gateway (Africa's Talking style). Put the same secret in the callback URL: /ussd?key=...
USSD_SHARED_SECRET=

# Outbound messages (optional). Without a provider the outbox simply queues.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
RESEND_API_KEY=
EMAIL_FROM=SkillProof <no-reply@yourdomain.com>

# Reminders and outbox delivery
ENABLE_JOBS=true
